@page "/Grades"
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationDbContext _context
@using Microsoft.AspNetCore.Mvc.RazorPages;
@using Microsoft.EntityFrameworkCore;
@using ElectronicStudentJournal.Models;
@using System.Security.Claims
@using ElectronicStudentJournal.Pages.Hover




    @if (students == null || subjects == null || grades == null)
    {
        <p><em>Ładowanie danych...</em></p>
    }
    else
    {
        <h2>Lista uczniów</h2>
        <table border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse;">
            <thead style="background-color: #a3c2b9;">
                <tr>
                    <th>Przedmiot</th>
                    <th>Oceny</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in subjects)
                {
                    <tr>
                        <td>@sub.Name</td>
                        <td>
                            @foreach (var grade in grades.Where(g => g.TeachingAssignment.SubjectId == sub.Id && g.Student.Id == Int32.Parse(userId)))
                            {
                            var tooltipText = $"Opis:{grade.Description} Data:{grade.Date.ToString("dd-MM-yyyy")}";
				                <ToolTip Tip="@tooltipText">
                                    <span>@grade.Value&nbsp;&nbsp;</span>
                                </ToolTip>

                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

@code {
    private string userId;
    private List<Student>? students;
    private List<Subject>? subjects;
    private List<Grade>? grades;
    int idStudenta = 0;

    protected override async Task OnInitializedAsync()
    {

        students = await _context.Students.ToListAsync();
        subjects = await _context.Subjects.ToListAsync();
        grades = await _context.Grades
            .Include(g => g.TeachingAssignment)
            .ThenInclude(t => t.Subject)
            .Include(g => g.Student)
            .ToListAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null)
        {
            if (user.Identity.IsAuthenticated)
            {
                userId = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
            }
        }
    }
}

