@if (ListaUczniow == null){
    <p>Nie ma danych</p>
}
else {
    <div class="flex flex-col place-content-center border-2 pt-32 border-amber-600 bg-sky-200 dark:bg-[#232141] min-w-screen min-h-screen space-y-5 gap-y-5 place-items-center">
        <table class="table-fixed place-self-center-safe border border-yellow-300 border-separate rounded-2xl  w-4/5 h-4/5 bg-cyan-200 sticky dark:bg-[#3a407ce5] dark:text-blue-100 text-black whitespace-nowrap">
            <thead>
                <tr>
                    <th class="table-th rounded-tl-2xl">Id</th>
                    <th class="table-th">Imie</th>
                    <th class="table-th">Nazwisko</th>
                    <th class="table-th">Wiek</th>
                    <th class="table-th">Numer pesel</th>
                    <th class="table-th">Data urodzenia</th>
                    <th class="table-th">Numer telefonu</th>
                    <th class="table-th rounded-tr-2xl">Adres zamieszkania</th>
                    @*<th>Ocena</th>*@
                </tr>
            </thead>
            <tbody>
                @foreach (var stud in ListaUczniow)
                {
                    <tr>
                        <td class="table-td-bottom-left">@stud.StudentId</td>
                        <td class="table-td">@stud.FirstName</td>
                        <td class="table-td">@stud.LastName</td>
                        <td class="table-td">@stud.Age</td>
                        <td class="table-td">@stud.PeselNumber</td>
                        <td class="table-td">@stud.FormattedBirthDate</td>
                        <td class="table-td">@stud.PhoneNumber</td>
                        <td class="table-td-bottom-right">@stud.HomeAddress</td>
                        @*<td>@stud.Rating</td>*@
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<StudentModel> ListaUczniow = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ListaUczniow = await DbContext.Students.ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Wystąpił błąd podczas ładowania danych: {ex.Message}");
        }
    }
}