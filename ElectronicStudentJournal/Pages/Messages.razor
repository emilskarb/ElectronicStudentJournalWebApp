@page "/messages"
@using ElectronicStudentJournal.Models
@using System.Globalization
@using ElectronicStudentJournal.Data

<div class="flex">

    <section class="pt-2 px-2 border border-pink-400 gap-4">
        <div class="border border-green-300 p-2">
            <h1>Poniedziałek</h1>
        </div>
        <SortableList Items="ClassSubjects" Context="subject" OnUpdate="SortList" Group="TimetableWeek">
            <SortableItemTemplate>
                    <div class="sortable-tile">@subject.JakiPrzedmiot</div>
            </SortableItemTemplate>
        </SortableList>
    </section>

    <section class="pt-2 px-2 border border-pink-400 gap-4">
        <div class="border border-green-300 p-2">
            <h1>Poniedziałek</h1>
        </div>
        <SortableList Items="ClassSubjects" Context="subject" OnUpdate="SortList" Group="TimetableWeek">
            <SortableItemTemplate>
                    <div class="sortable-tile">@subject.JakiPrzedmiot</div>
            </SortableItemTemplate>
        </SortableList>
    </section>

</div>

@code{
    public class LessonsForDay
    {
        public ClassSubject JakiPrzedmiot { get; set; }
        public string Nauczyciel { get; set; }
    }

    public List<LessonsForDay> ClassSubjects { get; set; } = new List<LessonsForDay>
    {
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Matematyka, Nauczyciel = "Mark" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Matematyka, Nauczyciel = "Jan Kowalski" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Polski, Nauczyciel = "Anna Nowak" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Angielski, Nauczyciel = "Elizabeth Smith" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Fizyka, Nauczyciel = "Piotr Zieliński" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Chemia, Nauczyciel = "Maria Skłodowska" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Biologia, Nauczyciel = "Ewa Adamczyk" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Historia, Nauczyciel = "Tomasz Jaworski" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Geografia, Nauczyciel = "Krzysztof Woliński" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Informatka, Nauczyciel = "Adam Bajt" },
        new LessonsForDay { JakiPrzedmiot = ClassSubject.Wf, Nauczyciel = "Robert Lewandowski" }
    };

    public void SortList((int oldIndex, int newIndex) indicies)
    {
        var (oldIndex, newIndex) = indicies;

        var items = this.ClassSubjects;
        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);

        if (newIndex < items.Count)
        {
            items.Insert(newIndex, itemToMove);
        }
        else
        {
            items.Add(itemToMove);
        }
    }
}