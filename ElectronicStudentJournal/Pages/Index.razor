@page "/"
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Strona główna</PageTitle>

<div class="content-container">
    <div class="tile-grid ">
        <NavLink href="gradez" class="tile">
            <h2>Oceny</h2>
            <p>Zobacz swoje postępy w nauce</p>
        </NavLink>
        <NavLink href="personaldata" class="tile">
            <h2>Twoje Dane</h2>
            <p>Sprawdź i zaktualizuj swoje informacje</p>
        </NavLink>
        <NavLink href="classtimetable" class="tile">
            <h2>Plan Zajęć</h2>
            <p>Sprawdź harmonogram lekcji</p>
        </NavLink>
        <NavLink href="messages" class="tile">
            <h2>Wiadomości</h2>
            <p>Skontaktuj się z nauczycielami</p>
        </NavLink>
    </div>
</div>

