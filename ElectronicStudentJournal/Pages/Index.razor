@page "/"

<PageTitle>Index</PageTitle>

<div class="row">
	<div class="col-12">
		<h2 class="fw-border">Welcome</h2>
		<AuthorizeView Roles="Admin">
			<p>Jesteś adminem</p>
		</AuthorizeView>

		<AuthorizeView Roles="Teacher,Student">
