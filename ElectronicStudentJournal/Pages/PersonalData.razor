@page "/personaldata"
@inject DataGenerator dataGen
@inject ApplicationDbContext DbContext 
@using ElectronicStudentJournal.Models

<h3>StudentData</h3>

@*<p>
    @dataGen.GenerateStudent().ToString()
</p>*@

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Imie</th>
            <th>Nazwisko</th>
            <th>Wiek</th>
            <th>Numer pesel</th>
            <th>Data urodzenia</th>
            <th>Numer telefonu</th>
            <th>Adres zamieszkania</th>
            <th>Ocena</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stud in students)
        {
            <tr>
                <td>@stud.StudentId</td>
                <td>@stud.FirstName</td>
                <td>@stud.LastName</td>
                <td>@stud.Age</td>
                <td>@stud.PeselNumber</td>
                <td>@stud.BirthDate</td>
                <td>@stud.PhoneNumber</td>
                <td>@stud.HomeAddress</td>
                <td>@stud.Rating</td>
            </tr>
        }
    </tbody>
</table>



<button type="button" class="btn btn-outline-primary" @onclick="LoadData">Dodaj ucznia</button>

@code {
    List<StudentModel> students = new();

    private void LoadData()
    {
        var results = dataGen.GenerateManyStudents().Take(10);
        students.AddRange(results);
        //foreach (var result in results)
        //{
        //    students.Add(result);
        //}
    }
}