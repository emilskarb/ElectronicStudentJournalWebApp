@page "/personaldata"
@inject DataGenerator dataGen
@inject ApplicationDbContext DbContext 
@using ElectronicStudentJournal.Models
@using Microsoft.EntityFrameworkCore;

<div class="div-table">
    <table class="table-main">
        <thead>
            <tr>
                <th class="table-th">Id</th>
                <th class="table-th">Imie</th>
                <th class="table-th">Nazwisko</th>
                <th class="table-th">Wiek</th>
                <th class="table-th">Numer pesel</th>
                <th class="table-th">Data urodzenia</th>
                <th class="table-th">Numer telefonu</th>
                <th class="table-th">Adres zamieszkania</th>
                @*<th>Ocena</th>*@
            </tr>
        </thead>
        <tbody>
            @foreach (var stud in students)
            {
                <tr>
                    <td class="table-td">@stud.StudentId</td>
                    <td class="table-td">@stud.FirstName</td>
                    <td class="table-td">@stud.LastName</td>
                    <td class="table-td">@stud.Age</td>
                    <td class="table-td">@stud.PeselNumber</td>
                    <td class="table-td">@stud.FormattedBirthDate</td>
                    <td class="table-td">@stud.PhoneNumber</td>
                    <td class="table-td">@stud.HomeAddress</td>
                    @*<td>@stud.Rating</td>*@
                </tr>
            }   
        </tbody>
    </table>


    @*<button type="button" class="rounded-full text-white bg-blue-500 h-9 w-24 hover:bg-blue-400 motion-reduce:hidden min-w-max px-3 @onclick="async () => await LoadData()">Dodaj ucznia</button>    *@
