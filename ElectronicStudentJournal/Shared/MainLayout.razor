@code {
    private bool isDarkMode = false;
    private bool isFirstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Pobierz zapisany motyw z LocalStorage
            var savedTheme = await LocalStorage.GetItemAsStringAsync("theme");

            // Jeśli nie ma zapisanego motywu, sprawdź preferencje systemowe
            if (string.IsNullOrEmpty(savedTheme))
            {
                // Sprawdź preferencje systemowe użytkownika
                var prefersDark = await JS.InvokeAsync<bool>(
                    "window.matchMedia",
                    "(prefers-color-scheme: dark)"
                ).ContinueWith(t => t.Result);

                isDarkMode = prefersDark;
                savedTheme = prefersDark ? "dark" : "light";
                await LocalStorage.SetItemAsStringAsync("theme", savedTheme);
            }
            else
            {
                isDarkMode = savedTheme == "dark";
            }

            // Zastosuj motyw
            if (isDarkMode)
            {
                await JS.InvokeVoidAsync("document.documentElement.classList.add", "dark");
            }
            else
            {
                await JS.InvokeVoidAsync("document.documentElement.classList.remove", "dark");
            }

            isFirstRender = false;
            StateHasChanged(); // Odśwież UI żeby pokazać właściwą ikonę
        }
    }

    private async Task ToggleTheme()
    {
        // Przełącz tylko jeśli komponent jest już zainicjalizowany
        if (!isFirstRender)
        {
            isDarkMode = !isDarkMode;

            if (isDarkMode)
            {
                await LocalStorage.SetItemAsStringAsync("theme", "dark");
                await JS.InvokeVoidAsync("document.documentElement.classList.add", "dark");
            }
            else
            {
                await LocalStorage.SetItemAsStringAsync("theme", "light");
                await JS.InvokeVoidAsync("document.documentElement.classList.remove", "dark");
            }
        }
    }
}
*@