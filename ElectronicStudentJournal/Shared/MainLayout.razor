@inherits LayoutComponentBase

<PageTitle>ElectronicStudentJournal</PageTitle>
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
		<div class="top-row px-4"
            <a href="https://docs.microsoft.com/aspnet/" target="_blank">About</a>
            <AuthorizeView>
                <NotAuthorized>
                    <a href="/Login">Login</a>
